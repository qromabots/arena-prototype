{
  "name": "arena-prototype",
  "private": true,
  "workspaces": [
    "platform/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n web,sync -c blue,green \"npm run dev -w @arena-prototype/web\" \"npm run dev:sync\"",
    "dev:web": "npm run dev -w @arena-prototype/web",
    "dev:sync": "node scripts/drawing-ws-server.mjs",
    "build": "npm run build -w @arena-prototype/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "ws": "^8.19.0"
  }
}
