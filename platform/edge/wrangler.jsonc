{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arena-drawing-sync",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "DRAWING_ROOMS",
        "class_name": "DrawingRoomDurableObject"
      },
      {
        "name": "USAGE",
        "class_name": "UsageDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DrawingRoomDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UsageDurableObject"]
    }
  ],
  "dev": {
    "port": 8043
  }
}
